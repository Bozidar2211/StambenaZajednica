@model StambenaZajednica.Models.Stan
@{
    ViewData["Title"] = "Obriši stan";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center text-danger">Da li ste sigurni da želite da obrišete ovaj stan?</h2>

    <dl class="row">
        <dt class="col-sm-3">Broj stana</dt>
        <dd class="col-sm-9">@Model.BrojStana</dd>

        <dt class="col-sm-3">Kvadratura</dt>
        <dd class="col-sm-9">@Model.Kvadratura m²</dd>

        <dt class="col-sm-3">Zajednica</dt>
        <dd class="col-sm-9">@Model.Zajednica?.Naziv ?? "N/A"</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a href="/Stan" class="btn btn-secondary">Otkaži</a>
    </form>

</div>
