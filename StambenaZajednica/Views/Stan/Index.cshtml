@model IEnumerable<StambenaZajednica.Models.Stan>
@{
    ViewData["Title"] = "Stanovi";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Stanovi</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Broj stana</th>
                <th>Kvadratura</th>
                <th>Zajednica</th>
                <th>Stanar</th>
                <th>PIN</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stan in Model)
            {
                <tr>
                    <td>@stan.BrojStana</td>
                    <td>@stan.Kvadratura m²</td>
                    <td>@(string.IsNullOrWhiteSpace(stan.Zajednica?.Naziv) ? "Nepoznata zajednica" : stan.Zajednica.Naziv)</td>
                    <td>
                        @if (stan.Stanar != null)
                        {
                            @($"{stan.Stanar.Ime} {stan.Stanar.Prezime}")
                        }
                        else
                        {
                            <span class="text-muted">Nema stanara</span>
                        }
                    </td>
                    <td>@stan.Pin</td>
                    <td>
                        @if (User.IsInRole("Upravnik"))
                        {
                            <a class="btn btn-sm btn-primary" href="/Stan/Edit/@stan.Id">Izmeni</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Stan" asp-action="Delete" asp-route-id="@stan.Id">Obriši</a>

                            //dodela stana
                            @if (stan.Stanar == null)
                            {
                               <a class="btn btn-sm btn-success"asp-controller="Stan"asp-action="Dodeli"asp-route-stanId="@stan.Id">Dodeli</a>
                            }
                            //reset pina
                            @if (stan.FinansijeZakljucane)
                            {
                                <a asp-controller="Finansije" asp-action="ResetujPin" asp-route-stanId="@stan.Id"
                                   class="btn btn-warning btn-sm">
                                    Otključaj / Resetuj PIN
                                </a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (User.IsInRole("Upravnik"))
    {
        <div class="text-end">
            <a class="btn btn-success" href="/Stan/Create">Dodaj novi stan</a>
        </div>
    }
</div>
