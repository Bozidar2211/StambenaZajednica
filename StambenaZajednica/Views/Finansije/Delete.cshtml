@model StambenaZajednica.Models.Racun

<div class="container mt-4">
    <h2>Potvrda brisanja</h2>
    <p>Da li ste sigurni da želite da obrišete račun za <strong>@Model.Tip</strong> u iznosu od <strong>@Model.Iznos RSD</strong>?</p>

    <form asp-action="Delete" asp-controller="Finansije" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a asp-action="Administracija" class="btn btn-secondary">Otkaži</a>
    </form>
</div>
