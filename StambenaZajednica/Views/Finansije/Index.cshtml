@{
    ViewData["Title"] = "Pristup finansijama";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Unesite PIN za pristup finansijama</h2>

    <form asp-action="Index" method="post">
        <div class="form-group mb-3">
            <label for="pin">PIN</label>
            <input type="password"
                   name="pin"
                   class="form-control"
                   maxlength="6"
                   pattern="\d{6}"
                   required
                   placeholder="******" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Pristupi</button>
    </form>

    <div class="text-danger mt-3">
        @Html.ValidationSummary()
    </div>
</div>
