@model StambenaZajednica.Models.Racun
@{
    ViewData["Title"] = "Dodaj novi račun";
}

<div class="container mt-4">
    <h2>Dodaj novi račun</h2>

    <form asp-action="Create" method="post">
        <div class="form-group mb-3">
            <label asp-for="Tip" class="form-label">Tip troška</label>
            <select asp-for="Tip" class="form-control" asp-items="Html.GetEnumSelectList<TipTroska>()" required>
                <option value="">-- Izaberi tip --</option>
            </select>
            <span asp-validation-for="Tip" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Iznos" class="form-label">Iznos</label>
            <input asp-for="Iznos" class="form-control" type="number" min="1" required />
            <span asp-validation-for="Iznos" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="DatumDospeca" class="form-label">Datum dospeća</label>
            <input asp-for="DatumDospeca" type="date" class="form-control" required />
            <span asp-validation-for="DatumDospeca" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Opis" class="form-label">Opis</label>
            <input asp-for="Opis" class="form-control" />
            <span asp-validation-for="Opis" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="StanId" class="form-label">Račun za stan (opciono)</label>
            <select asp-for="StanId" asp-items="ViewBag.Stanovi" class="form-control">
                <option value="">-- Odaberi stan --</option>
            </select>
            <span asp-validation-for="StanId" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="StambZajednicaId" class="form-label">Račun za zajednicu</label>
            <select asp-for="StambZajednicaId" asp-items="ViewBag.Zajednice" class="form-control" required>
                <option value="">-- Odaberi zajednicu --</option>
            </select>
            <span asp-validation-for="StambZajednicaId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Sačuvaj</button>
    </form>
</div>
