@model StambenaZajednica.Models.Uplata

<div class="container mt-4">
    <h2>Dodaj uplatu</h2>

    <form method="post">
        <div class="form-group">
            <label for="RacunId">Račun</label>
            <select asp-for="RacunId" asp-items="ViewBag.Racuni" class="form-control"></select>
        </div>

        <div class="form-group">
            <label for="StanarId">Stanar</label>
            <select asp-for="StanarId" asp-items="ViewBag.Stanari" class="form-control"></select>
        </div>

        <div class="form-group">
            <label for="Iznos">Iznos</label>
            <input asp-for="Iznos" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Sačuvaj</button>
    </form>
</div>
