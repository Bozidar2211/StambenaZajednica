@model StambenaZajednica.Models.StambZajednica
@{
    ViewData["Title"] = "Obriši zajednicu";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center text-danger">Da li ste sigurni da želite da obrišete ovu zajednicu?</h2>

    <dl class="row">
        <dt class="col-sm-3">Naziv</dt>
        <dd class="col-sm-9">@Model.Naziv</dd>

        <dt class="col-sm-3">Adresa</dt>
        <dd class="col-sm-9">@Model.Adresa</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Obriši</button>
        <a href="/Zajednica" class="btn btn-secondary">Otkaži</a>
    </form>

</div>
