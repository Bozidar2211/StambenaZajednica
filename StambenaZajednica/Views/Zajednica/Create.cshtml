@model StambenaZajednica.Models.StambZajednica
@{
    ViewData["Title"] = "Dodaj zajednicu";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">@ViewData["Title"]</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Naziv" class="form-label">Naziv</label>
            <input asp-for="Naziv" class="form-control" />
            <span asp-validation-for="Naziv" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Adresa" class="form-label">Adresa</label>
            <input asp-for="Adresa" class="form-control" />
            <span asp-validation-for="Adresa" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="BrojZgrade" class="form-label">Broj zgrade</label>
            <input asp-for="BrojZgrade" class="form-control" />
            <span asp-validation-for="BrojZgrade" class="text-danger"></span>
        </div>


        <button type="submit" class="btn btn-primary w-100">Sačuvaj</button>
    </form>
</div>
