@model IEnumerable<StambenaZajednica.Models.StambZajednica>
@{
    ViewData["Title"] = "Stambene zajednice";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Stambene zajednice</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Naziv</th>
                <th>Adresa</th>
                <th>Broj zgrade</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var z in Model)
            {
                <tr>
                    <td>@z.Naziv</td>
                    <td>@z.Adresa</td>
                    <td>@z.BrojZgrade</td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/Zajednica/Edit/@z.Id">Izmeni</a>
                        <a class="btn btn-sm btn-danger" asp-controller="Zajednica" asp-action="Delete" asp-route-id="@z.Id">Obriši</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end">
        <a class="btn btn-success" href="/Zajednica/Create">Dodaj novu zajednicu</a>
    </div>
</div>
